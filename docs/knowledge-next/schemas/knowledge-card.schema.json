{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraia.local/schemas/knowledge-card.schema.json",
  "title": "Fraia KnowledgeCard",
  "description": "Candidate typed card for source-backed Fraia engineering knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "schema_version",
    "title",
    "status",
    "domain",
    "summary",
    "concepts",
    "claims",
    "source_links",
    "applicability",
    "limitations",
    "relationships",
    "media_links"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^KC-[a-z0-9][a-z0-9-]*$"
    },
    "schema_version": {
      "const": "knowledge-card.v0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "draft",
        "reviewed",
        "deprecated"
      ]
    },
    "domain": {
      "type": "string",
      "description": "Engineering area such as structural-analysis, steel-design, stability, modeling, or Fraia product architecture."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "confidence",
          "source_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^SRC-[a-f0-9]{10}$"
                },
                "locator": {
                  "type": "string",
                  "description": "Page, chapter, section, figure, table, URL fragment, or other source-specific locator."
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies_to",
        "not_applicable_to",
        "jurisdiction_or_standard_context"
      ],
      "properties": {
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_applicable_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jurisdiction_or_standard_context": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationship_type",
          "target"
        ],
        "properties": {
          "relationship_type": {
            "type": "string",
            "enum": [
              "requires",
              "supports",
              "contrasts_with",
              "refines",
              "replaces",
              "see_also"
            ]
          },
          "target": {
            "type": "string",
            "description": "Another card id, wiki path, Fraia schema object, or topic tag."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "source_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[a-f0-9]{10}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "corroborating",
              "counterexample",
              "discovery",
              "internal_context"
            ]
          },
          "pages_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "media_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "role"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^KA-[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "explains",
              "example",
              "counterexample",
              "generated_view"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "fraia_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structural_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Node",
              "Member",
              "Plate",
              "SupportAssignment",
              "LoadAssignment",
              "ReleaseAssignment"
            ]
          },
          "uniqueItems": true
        },
        "pipeline_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "builder_graph",
              "structural_model",
              "realization",
              "analysis_results",
              "design_actions",
              "check_inputs",
              "check_results",
              "exports"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
